#!/bin/sh

#***********************************************************************************************************************************************************#
# FILENAME:		dsp_upgrade
#
# DESCRIPTION:     This is a tool/script to upgrade dsp firmware. This will check the dsp firmware files in /etc/fw/dsp directory.
#			    it will trigger from peripheral_updater init process if, firmware files presents in /etc/fw/dsp directory.
#
