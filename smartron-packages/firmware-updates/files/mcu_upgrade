#!/bin/sh

#***********************************************************************************************************************************************************#
# FILENAME:		mcu_upgrade
#
# DESCRIPTION:     This is a tool/script to upgrade dsp firmware. This will check the mcu firmware files in /etc/fw/mcu directory.
#			    it will trigger from peripheral_updater init process if, firmware files presents in /etc/fw/mcu directory.
#
