									<value>0</value>
								</enumeratedValue>
								<enumeratedValue>
									<name>ACCESS_IS_IN_PRIVILE</name>
									<description>Access is in privileged mode.</description>
									<value>1</value>
								</enumeratedValue>
							</enumeratedValues>
