prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: libzwscene
Description: zwscene library provides support for z-ware scenes
URL: www.sigmadesigns.com
Version: @VERSION@
Requires: glib-2.0
Libs: -L${libdir} -lzwscene
Cflags: -I${includedir} -DHAVE_LIBZWSCENE=1
